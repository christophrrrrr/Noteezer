# Copy to .env (git ignores it) and fill in both values. docker compose reads it.
# DB_PASSWORD: SQL Server needs 8+ characters with upper, lower, digits, and symbols.
# SESSION_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
DB_PASSWORD=
SESSION_SECRET=
# Optional: turns on Gemini sorting.
GEMINI_API_KEY=
