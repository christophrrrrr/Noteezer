# Copy to .env (git ignores it) and fill in the values. docker compose reads it.
#
# SA_PASSWORD is SQL Server's administrator, used only to create the databases
# and logins. INBOX_DB_PASSWORD and REMINDERS_DB_PASSWORD are the two services'
# own logins. SQL Server wants 8+ characters with upper and lower case letters
# and digits. The service passwords go inside a URL, so use only letters,
# digits, - and _ there. This prints three good ones:
#   python -c "import secrets; [print(secrets.token_hex(12) + 'Ab1') for _ in range(3)]"
SA_PASSWORD=
INBOX_DB_PASSWORD=
REMINDERS_DB_PASSWORD=
# SESSION_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Optional: turns on Gemini sorting.
GEMINI_API_KEY=
